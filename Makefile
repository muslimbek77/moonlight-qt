moonlight-qt.pro:
qmake: FORCE
	@$(QMAKE) -o Makefile moonlight-qt.pro

qmake_all: sub-moonlight-common-c-qmake_all sub-qmdnsengine-qmake_all sub-app-qmake_all sub-h264bitstream-qmake_all FORCE

make_first: sub-moonlight-common-c-make_first sub-qmdnsengine-make_first sub-app-make_first sub-h264bitstream-make_first  FORCE
all: sub-moonlight-common-c-all sub-qmdnsengine-all sub-app-all sub-h264bitstream-all  FORCE
clean: sub-moonlight-common-c-clean sub-qmdnsengine-clean sub-app-clean sub-h264bitstream-clean  FORCE
distclean: sub-moonlight-common-c-distclean sub-qmdnsengine-distclean sub-app-distclean sub-h264bitstream-distclean  FORCE
	-$(DEL_FILE) Makefile
	-$(DEL_FILE) .qmake.stash
install_subtargets: sub-moonlight-common-c-install_subtargets sub-qmdnsengine-install_subtargets sub-app-install_subtargets sub-h264bitstream-install_subtargets FORCE
uninstall_subtargets: sub-moonlight-common-c-uninstall_subtargets sub-qmdnsengine-uninstall_subtargets sub-app-uninstall_subtargets sub-h264bitstream-uninstall_subtargets FORCE

sub-moonlight-common-c-debug:
	@test -d moonlight-common-c/ || mkdir -p moonlight-common-c/
	cd moonlight-common-c/ && ( test -e Makefile || $(QMAKE) -o Makefile /home/rasulbek/muslim-projects/moonlight-qt/moonlight-common-c/moonlight-common-c.pro ) && $(MAKE) -f Makefile debug
