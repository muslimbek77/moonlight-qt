FORCE:

dist: distdir FORCE
	(cd `dirname $(DISTDIR)` && $(TAR) $(DISTNAME).tar $(DISTNAME) && $(COMPRESS) $(DISTNAME).tar) && $(MOVE) `dirname $(DISTDIR)`/$(DISTNAME).tar.gz . && $(DEL_FILE) -r $(DISTDIR)

distdir: sub-moonlight-common-c-distdir sub-qmdnsengine-distdir sub-app-distdir sub-h264bitstream-distdir FORCE
	@test -d $(DISTDIR) || mkdir -p $(DISTDIR)
	$(COPY_FILE) --parents .qmake.stash moonlight-qt.pro $(DISTDIR)/

sub-moonlight-common-c-distdir: FORCE
	@test -d moonlight-common-c/ || mkdir -p moonlight-common-c/
	cd moonlight-common-c/ && ( test -e Makefile || $(QMAKE) -o Makefile /home/rasulbek/muslim-projects/moonlight-qt/moonlight-common-c/moonlight-common-c.pro ) && $(MAKE) -e -f Makefile distdir DISTDIR=$(DISTDIR)/moonlight-common-c

